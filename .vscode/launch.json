{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug PyTorch training (batch=1)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_pytorch.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "CUDA_VISIBLE_DEVICES": "0"
      },
      "args": [
        "debug",
        "--batch-size",
        "1",
        "--num-train-steps",
        "10",
        "--exp-name",
        "debug",
        "--overwrite"
      ]
    }
  ]
}
